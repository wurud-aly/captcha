    "anchors.entry": "right-hand connection point (where the previous letter joins). Required for medial and final forms.",
    "anchors.exit": "left-hand connection point (where the next letter joins). Required for initial and medial forms.",
    "adjust": "per-sample fine tuning: offsetX/offsetY in original px, scale multiplier, thickness in px (+ thicker, - thinner)"
  },
