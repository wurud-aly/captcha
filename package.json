{
  "name": "arabic-hybrid-captcha",
  "version": "1.0.0",
  "description": "Arabic CAPTCHA: arrange scrambled letters to form a word. Static site for GitHub Pages.",
  "type": "module",
  "private": true,
  "license": "MIT",
  "scripts": {
    "start": "node scripts/serve.mjs --port 8080",
    "start:pages": "node scripts/serve.mjs --port 8080 --base /arabic-hybrid-captcha/",
    "build:pages": "node scripts/build-pages.mjs _site",
    "test": "node --test tests/unit/*.test.mjs",
    "test:e2e": "node tests/e2e/run-e2e.mjs"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "playwright": "^1.56.0"
  }
}
